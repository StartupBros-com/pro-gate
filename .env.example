# pro-gate config — copy to $PRO_GATE_HOME/.env (default: ~/.pro-review-daemon/.env).
# Paths default sensibly; you mainly need to set the watched owner(s).

# REQUIRED for the daemon: space-separated GitHub owners (orgs/users) to watch for the label.
PRO_REVIEW_OWNERS=

# Optional — a connector-bound ChatGPT Project URL. Use only with the explicit
# PRO_GATE_INPUT_POLICY=connector-enabled opt-in below. A configured browser/project connector grant
# remains an operator trust boundary even when Pro-Gate itself sends bundle-only input.
#ORACLE_CHATGPT_URL=

# Input delivery policy: bundle-only is the safe default. It attaches the reviewed diff and never
# asks ChatGPT to use its GitHub connector. To opt in once to connector delivery, set this exact value:
#PRO_GATE_INPUT_POLICY=connector-enabled
# The daemon inherits that engine policy while empty. Set bundle, both, or connector only to request
# an explicit mode for every daemon query/effect/worker invocation.
#PRO_REVIEW_INPUT=

# Daemon orchestrator + cost knobs
PRO_REVIEW_LABEL=pro-review
PRO_REVIEW_POLL_SECONDS=180
PRO_REVIEW_CLAUDE_MODEL=sonnet
PRO_REVIEW_FALLBACK_MODEL=haiku
PRO_REVIEW_MAX_BUDGET_USD=5            # hard $ ceiling per PR (headless claude bills API credits)
PRO_REVIEW_MAX_FAILS=3
#PRO_REVIEW_AGENT_TIMEOUT=10800        # daemon bound on ONE headless agent session (seconds).
                                       # Covers the engine's worst-case single-invocation
                                       # envelope (~160 min: two lock waits + primary +
                                       # retries + salvage); the daemon's recoverable-state
                                       # guard makes an overrun non-catastrophic regardless.
#PRO_GATE_RUN_LOGS=1                   # 1 (default) = persist each run's stderr diagnostics
                                       # to logs/<marker>.log (swept after 14 days); 0 = off
#PRO_GATE_PLUGIN_KEY=pro-gate@hov      # plugin identity the auto-updater follows in
                                       # installed_plugins.json: "<plugin>@<marketplace NAME>"
                                       # (the marketplace's DECLARED name, "hov", not its repo
                                       # name "hov-marketplace"; override for forks)
#PRO_GATE_PLUGIN_SEARCH_DIR=$HOME/.claude/plugins  # where pro-gate-autoupdate.sh looks for the
                                       # installed marketplace plugin manifest whose version
                                       # the runtime follows (enable: install.sh --auto-update)
#PRO_GATE_DAEMON_SELF_RELOAD=1         # 1 = the daemon re-execs itself at the idle top of its poll
                                       # loop when it detects its own code was redeployed (picks up
                                       # a new daemon.sh/lib.sh without a control-group-killing
                                       # `systemctl restart`; never interrupts an in-flight review).
                                       # 0 = only a manual restart reloads new daemon code.

# Concurrency: serialize Pro reviews against your single ChatGPT account
PRO_GATE_LOCK_WAIT=2400                # seconds a queued review waits before giving up
#PRO_GATE_MAX_CONCURRENCY=1            # CEILING for parallel Pro chats; the ramp governor earns up to it
#PRO_GATE_RAMP=1                       # 1 = adaptive (earn levels via clean streaks; drop to 1 on throttle); 0 = pin at ceiling
#PRO_GATE_RAMP_STREAK=5                # clean runs required per level increase
#PRO_GATE_SELF_HEAL=1                  # try 'sudo -n systemctl start oracle-chrome' when CDP is down (passwordless sudo only)
#PRO_GATE_BROWSER_ARCHIVE=never        # passed through unchanged to oracle. Keep 'never' for safe
                                       # probe/salvage ownership; auto/always may archive before
                                       # pro-gate has durably validated and saved the review.
#PRO_GATE_CHAT_RENAME=1                # remote Chrome: set the exact canonical PR/round title through
                                       # ChatGPT's UI (default 1; native mode uses prompt bias only)
#PRO_GATE_CHAT_ARCHIVE=1               # archive through ChatGPT's UI only after exit 0 and a readable,
                                       # marker-addressed completed/pending result (default 1)
#PRO_GATE_KEEP_TABS=0                  # exact value 1 keeps the server conversation unarchived AND
                                       # its local tab open for debugging; exact rename may still occur
#PRO_GATE_THROTTLE_COOLDOWN=900        # seconds all runs defer after a "requests too quickly" interstitial
#PRO_GATE_THROTTLE_PAUSE=300           # pause before the one polite salvage attempt after a throttle hit

# Memory headroom: the review drives a headless Chrome that needs RAM. On a low-memory box the
# engine defers up front (exit 8, no spend) rather than crash mid-review; it also warns before a
# run when memory is tight, and if Chrome restarts mid-review from OOM it says so on exit 6.
#PRO_GATE_MIN_AVAIL_MB=1024            # defer the run when free RAM is below this many MB
#PRO_GATE_MAX_SWAP_PCT=97              # defer when swap is at/above this % AND free RAM < 2x MIN_AVAIL_MB
#PRO_GATE_SWAP_WARN_PCT=80             # soft heads-up (non-blocking) when swap is at/above this %

# Diff-size handling (v0.20/v0.24): the deep think is the point, and the engine harvests a review
# that outlasts the slot window for free. So a large diff no longer refuses — past the cook
# threshold it proceeds and is expected to land in-progress (exit 9), to be collected with
# --harvest. Only past the hard ceiling does it refuse up front (exit 11) with a delta-scoping
# recipe (a payload that large risks context overflow / is usually a generated blob).
#PRO_GATE_MAX_DIFF_LINES=6000          # cook threshold: above this the run proceeds but usually exits 9 (in-progress) -> harvest
#PRO_GATE_DIFF_HARD_MAX=25000          # hard ceiling: refuse above this (exit 11, no spend); floats up to MAX_DIFF_LINES if that is larger
#PRO_GATE_DIFF_WARN_LINES=2500         # stderr warning above this many diff lines
#PRO_GATE_DIFF_GUARD=1                 # 0 = disable the hard ceiling too (cook any size)

# Review round history (v0.22; trajectory scoring since v0.31/#65): review->fix->re-review
# loops once burned 10-16 Pro slots on one PR. Since v0.37 the ordinary unset configuration is
# ADVISORY: counts, open-P0/P1 trajectory, churn, elapsed time, and the computed grant remain in
# --status, but they never impersonate ChatGPT subscription quota or block changed proven evidence.
# Active/recoverable work, identical code+evidence, provenance, throttle, health, concurrency, and
# payload guards remain hard safety gates.
#
# Explicit operator settings preserve hard enforcement for compatibility. Set ROUND_GUARD=1 for
# the trajectory governor, set MAX_ROUNDS_PER_PR for the legacy flat cap, or set base/cap to zero
# for lockdown. ROUND_GUARD=0 overrides every limit and keeps history advisory/off. Positive
# pre-Send proof refunds exactly once; post-click uncertainty and watchdog-killed attempts remain
# charged. A submitted terminal infrastructure error or bounded recovery exhaustion releases
# recovery ownership but retains the charge.
#PRO_GATE_ROUNDS_BASE=3                # SETTING this enables the governor (0 = lockdown)
#PRO_GATE_ROUNDS_CEILING=8             # SETTING this enables an enforced hard ceiling
#PRO_GATE_MAX_ROUNDS_PER_PR=4          # SETTING this enables the legacy flat cap (0 = lockdown)
#PRO_GATE_ROUNDS_WINDOW=24h            # telemetry/enforcement window; defaults to 24h
#PRO_GATE_ROUND_GUARD=1                # explicit enforcement; 0 forces advisory/off
#PRO_GATE_FORCE_ROUND=1                # one invocation past an active explicit cap
#PRO_GATE_RESERVATION_TTL=21600         # minimum age before confirmed marker misses may exhaust
                                       # recovery (6h). Elapsed time alone never releases capacity.
#PRO_GATE_HARVEST_TTL_SWEEP=1          # 0 = don't count a past-TTL target miss from harvest
#PRO_GATE_RESERVATION_MISSES=3          # consecutive confirmed marker misses before release
#PRO_GATE_RECONCILE_INTERVAL=60         # min seconds between reconcile probes of one marker
#PRO_GATE_HARVEST_LOCK_WAIT=5           # seconds a duplicate same-marker harvest waits
#PRO_GATE_TAB_SWEEP=1                   # 0 = never auto-close leaked chatgpt.com root tabs pre-run

# Watchdog + recovery clocks (v0.14; salvage knob v0.30.1). A healthy oracle prints a status
# line every ~30s, so STALL (total log silence) only fires on a genuinely hung CLI; NOTHINK is
# the earliest a "no thinking status detected" run may be probed — the pre-kill CDP probe
# routes any live tab to salvage with the full hard-cap budget, so NOTHINK mainly protects
# slow submissions/attachment uploads from a premature dead-submission verdict.
#PRO_GATE_STALL_SECS=600                # kill after this much total oracle-log silence. 300 is
                                        # reasonable once you trust the 30s cadence (hung runs
                                        # die 5 min sooner) — but then set SALVAGE_SECS below.
#PRO_GATE_NOTHINK_SECS=600              # floor before a no-think run can be probed/killed
#PRO_GATE_SALVAGE_SECS=                 # non-live salvage window; empty = follows STALL_SECS
                                        # (the pre-v0.30.1 tie). Set 600 when lowering STALL_SECS
                                        # so a shorter stall fuse doesn't shrink recovery.
#PRO_GATE_TIMEOUT_GRACE=120             # extra seconds past --timeout before the hard kill
#PRO_GATE_MODEL_WEAK_PATTERN=mini|nano|instant  # case-insensitive regex; a resolved model matching it
                                       # (or an unreadable model) fires an ADVISORY downgrade warning
                                       # (a WARN log line + a status marker the review header shows).
                                       # Never blocks or fails a run. A denylist of cheap markers, NOT
                                       # a Pro-tier allowlist (which would false-warn on a future top
                                       # model whose name lacks "Pro").

# Platform is auto-detected (macOS=native, WSL/Linux=remote-chrome). Override only if needed:
#PRO_GATE_BROWSER_MODE=native          # set remote-chrome on a headless/server Mac (see note below)
#PRO_GATE_REPOS_DIR=$HOME/SITES        # where the daemon finds local checkouts of watched repos
#PRO_GATE_MODEL_STRATEGY=current       # current (default, RECOMMENDED) = review whatever model your
                                       # ChatGPT account already has selected. Pin the top tier by
                                       # selecting "Pro" (= GPT-5.6 Sol Pro) once in the account picker
                                       # via login-view.sh; it persists in the profile. No version to
                                       # bump here when the account moves to a new model.
                                       # select = actively switch the picker to ORACLE_MODEL and verify
                                       # it. AVOID with gpt-5.6 on oracle 0.16.0: oracle expands gpt-5.6
                                       # to the label "GPT-5.6 Sol" and cannot match it in the switcher
                                       # (offered: Instant5.5, Medium, High, Extra High, Pro, GPT-5.6
                                       # Sol), so the run fails model selection without submitting
                                       # (dogfood 2026-07-17, PR #32). The engine now auto-falls-back
                                       # select->current on that error, but `current` + the account
                                       # picker is the reliable path. oracle 0.17.2 (2026-08-10) supports
                                       # the current Advanced model/effort pickers and the GPT Pro alias;
                                       # verify `select` deliberately on your own box before switching
                                       # away from `current`.
# Headless/server Mac (e.g. a mac-mini review box): oracle's native cookie path needs an unlocked login
# keychain, which is painful over SSH. Use PRO_GATE_BROWSER_MODE=remote-chrome and launch Chrome yourself
# with --password-store=basic --remote-debugging-port=9222 (keychain-free). See docs/SETUP-NOTES.md.

# Model hint: passed to oracle as the `-m` "requested" value. `gpt-5.6` is oracle's alias for the
# GPT-5.6 Sol flagship (the successor to gpt-5.5-pro). Under the default `current` strategy this is
# only a hint (the account's already-selected model wins); under `select` it is the model the picker
# is switched to and verified. This is the one functional model id in the stack; it never appears in
# any human-facing review surface, which report the model actually resolved for the run (or
# role-based text), not this value. Bump it when the frontier moves (e.g. a future gpt-5.7).
ORACLE_MODEL=gpt-5.6

# --- WSL/Linux (remote-chrome) only: the durable Xvfb Chrome ---
# Port coexistence: 9222 is this bridge's port BY CONVENTION; the wsl-cdp
# plugin (github.com/StartupBros-com/wsl-cdp — WSL2 agents driving a real
# Windows browser) reserves 9223/9224 for the same reason. Keep them apart.
# wsl-cdp can in principle serve as an alternative backend for this same
# ORACLE_BROWSER_PORT (oracle's --remote-chrome is backend-agnostic), but do
# NOT point it at a shared agent profile: ChatGPT needs its own dedicated
# profile, pro-gate's self-heal must be off (PRO_GATE_SELF_HEAL=0), and the
# oracle-chrome systemd unit disabled — tracked as wsl-cdp's profile-dir
# override feature; until that lands, the Xvfb Chrome below is the WSL path.
ORACLE_BROWSER_ALLOW_COOKIE_ERRORS=1
#ORACLE_DISPLAY=:99
#ORACLE_BROWSER_PORT=9222
#ORACLE_XVFB_SCREEN=1360x1000x24
#ORACLE_BROWSER_PROFILE_DIR=$HOME/.oracle/browser-profile
#ORACLE_VNC_PORT=5999
#ORACLE_NOVNC_PORT=6080
#ORACLE_VNC_BIND=127.0.0.1
